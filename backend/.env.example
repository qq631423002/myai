# ===== 数据库 =====
# MySQL 示例；不配置则默认回退到本地 SQLite（backend/app.db），开箱即可跑 demo
DATABASE_URL=mysql+pymysql://root:root@localhost:3306/pyai

# ===== DeepSeek API（OpenAI 兼容接口）=====
# Key 申请地址：https://platform.deepseek.com/api_keys
API_KEY=myapiky
API_BASE_URL=https://api.deepseek.com
# 可选模型：deepseek-flash（当前推荐）/ deepseek-v4-pro（更强）
# deepseek-v4-flash 是旧名，仍被接受，请求会由 DeepSeek-V4.1-Flash 承接
MODEL_NAME=deepseek-v4-flash

# ===== RAG（「读书陪读」功能用的向量检索）=====
# 把书里的文字转向量用的模型。DeepSeek 没有 embedding 接口，所以用本地模型。
# 首次使用会自动下载权重（约 100MB）。想换更准但更慢的模型可改成：
#   EMBEDDING_MODEL=BAAI/bge-base-zh-v1.5   （768 维，慢一倍左右）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 模型下载源。国内直连 huggingface.co 基本不通，默认走镜像站；
# 如果你能直连官方源（或有代理），改成 https://huggingface.co 即可。
HF_ENDPOINT=https://hf-mirror.com

# ===== Session 中间件密钥（换成一段随机字符串）=====
SECRET_KEY=请换成一段足够长的随机字符串
